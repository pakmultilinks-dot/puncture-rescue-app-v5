{
  "expo": {
    "name": "Patchlane",
    "slug": "patchlane-puncture-demo-v5",
    "owner": "kominman",
    "version": "5.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "description": "Area-search pilot for motorcycle puncture help. Provider availability varies; booking and dispatch are not available.",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kominman.patchlane",
      "versionCode": 2,
      "allowBackup": false,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F4EF"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "d277772b-625c-4b66-8264-f6b0ff8a03d3"
      }
    }
  }
}
