{
  "expo": {
    "name": "Patchlane",
    "slug": "patchlane-puncture-demo-v5",
    "owner": "kominman",
    "version": "5.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "description": "Motorcycle puncture-help pilot. Listings appear only with current verification and consent.",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kominman.patchlane",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Patchlane to check your location once after you tap; location is not shared or used to match listings."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d277772b-625c-4b66-8264-f6b0ff8a03d3"
      }
    }
  }
}
